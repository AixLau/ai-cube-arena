# 复制为 .env 后按需修改。模型与 API Key 推荐直接在页面「模型配置」中添加（支持任意供应商与中转站）。

# 后端端口（开发模式下 Vite 会把 /api 代理到此端口；生产模式也可用 PORT）
API_PORT=8787

# —— API Key 加密存储 ——
# 设置后，用户可在模型配置中勾选「在服务端加密保存密钥」（AES-256-GCM）。至少 16 个字符，请妥善保管。
# 未设置时密钥只保存在服务端内存中，服务重启后需重新输入。
# CREDENTIAL_SECRET=

# —— 正式部署 ——
# 强制 HTTPS（反向代理需传递 X-Forwarded-Proto）
# REQUIRE_HTTPS=true
# TRUST_PROXY=1

# —— 评测并发与超时 ——
# 全局同时运行的模型会话上限（所有评测共享）
# MAX_ACTIVE_SESSIONS=16
# 单次 API 请求超时（毫秒）
# LLM_TIMEOUT_MS=180000

# —— 自定义地址安全策略（默认严格，仅本地开发时放开）——
# 允许访问内网 / 本机地址（例如本机运行的模型服务）。生产环境切勿开启。
# ALLOW_PRIVATE_PROVIDER_HOSTS=true
# 允许 http:// 地址
# ALLOW_HTTP_PROVIDERS=true

# —— 服务端预置模型（可选，只读，密钥不会下发到浏览器）——
# DEEPSEEK_API_KEY=
# DASHSCOPE_API_KEY=
# MOONSHOT_API_KEY=
# ZHIPU_API_KEY=
# ARK_API_KEY=
# MINIMAX_API_KEY=
# 可覆盖预置的地址与模型，例如：DEEPSEEK_MODEL=deepseek-reasoner、DOUBAO_MODEL=ep-xxxx
