# 复制为 .env 后按需修改。模型与 API Key 只在浏览器会话中配置，不保存到服务端。

# 后端端口（开发模式下 Vite 会把 /api 代理到此端口；生产模式也可用 PORT）
API_PORT=8787

# —— 正式部署 ——
# 强制 HTTPS（反向代理需传递 X-Forwarded-Proto）
# REQUIRE_HTTPS=true
# TRUST_PROXY=1

# —— 评测并发与超时 ——
# 全局同时运行的模型会话上限（所有评测共享）
# MAX_ACTIVE_SESSIONS=16
# 单次 API 请求超时（毫秒）
# LLM_TIMEOUT_MS=180000

# —— 自定义地址安全策略（默认严格，仅本地开发时放开）——
# 允许访问内网 / 本机地址（例如本机运行的模型服务）。生产环境切勿开启。
# ALLOW_PRIVATE_PROVIDER_HOSTS=true
# 允许 http:// 地址
# ALLOW_HTTP_PROVIDERS=true
